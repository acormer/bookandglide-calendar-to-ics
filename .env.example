# BookAndGlide credentials
BG_EMAIL=your@email.com
BG_PASSWORD=yourpassword

# Optional: if set, ?token=<value> is required to access ICS endpoints
CALENDAR_SECRET=

# Database — local: postgresql://postgres:postgres@localhost:5432/bookandglide
#            prod:  postgresql://... (Neon connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookandglide

# Better Auth
BETTER_AUTH_SECRET=    # generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
